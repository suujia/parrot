<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    The bundle is signed with the hardened runtime (codesign - -options runtime).
    Under the hardened runtime, microphone capture is refused unless the process
    carries this entitlement; it is the only one Parrot needs. System audio
    (Core Audio process taps) is governed by TCC alone.
    -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
